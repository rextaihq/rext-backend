#!/bin/sh
# Pre-commit quality gate. No bypass flags, no skip env vars.
#
#   1. Import integrity  — repo-wide, against git's INDEX
#   2. Ruff lint         — staged files only  (E/F/I: undefined names,
#                          bad imports, syntax-level errors)
#   3. Ruff format       — staged files only
#
# Why the index and not your working tree: a module sitting on your disk but
# never `git add`-ed does not exist for anyone else. That exact case shipped a
# crash-looping image to stage on 2026-09-02. So the index is exported into a
# temporary directory and every check runs there: a staged file fixed only on
# disk is judged as staged, and unstaged work never blocks a commit.
#
# Why staged-files-only for ruff: the repo carries ~3700 pre-existing lint
# errors. Repo-wide would block every commit. New and changed code is held to
# the standard; the backlog is not dragged into your commit.
#
# Enable once per clone:  git config core.hooksPath .githooks

set -e

# Probe each candidate: on Windows `python3` is often a Microsoft Store stub
# that exists on PATH but cannot execute anything.
for c in python3 python py; do
    if "$c" -c "import sys" >/dev/null 2>&1; then PY="$c"; break; fi
done
if [ -z "$PY" ]; then
    echo "pre-commit: no working python interpreter found on PATH." >&2
    exit 1
fi

REPO=$(git rev-parse --show-toplevel)

if command -v ruff >/dev/null 2>&1; then
    RUFF="ruff"
elif command -v uv >/dev/null 2>&1; then
    RUFF="uv run ruff"
elif "$PY" -m ruff --version >/dev/null 2>&1; then
    # pip-installed on Windows often leaves ruff.exe off PATH
    RUFF="$PY -m ruff"
else
    echo "pre-commit: ruff not found." >&2
    echo "  install it with:  uv sync --group dev   (or: pip install 'ruff>=0.13.0')" >&2
    exit 1
fi

# Ruff runs inside the snapshot (its config is the staged one) on the staged
# paths, read NUL-separated from $STAGED_LIST; under uv it keeps the repository's
# environment instead of building one in the snapshot.
ruff_staged() {
    if [ "$RUFF" = "uv run ruff" ]; then
        xargs -0 uv run --project "$REPO" ruff "$@" < "$STAGED_LIST"
    else
        # shellcheck disable=SC2086
        xargs -0 $RUFF "$@" < "$STAGED_LIST"
    fi
}

# ── the snapshot being committed ──────────────────────────────────────────
SNAPSHOT=$(mktemp -d "${TMPDIR:-/tmp}/rext-pre-commit.XXXXXX")
STAGED_LIST=$(mktemp "${TMPDIR:-/tmp}/rext-pre-commit-staged.XXXXXX")
trap 'rm -rf "$SNAPSHOT" "$STAGED_LIST"' EXIT INT TERM
git checkout-index --all --prefix="$SNAPSHOT/"

fail=0

# ── 1. imports ────────────────────────────────────────────────────────────
# Every file in the snapshot is in the index, so it is checked as it is on disk there.
echo "pre-commit: checking import integrity..."
(cd "$SNAPSHOT" && "$PY" scripts/check_imports.py) || fail=1

# ── 2 & 3. ruff on staged python files ────────────────────────────────────
# ACMR = added/copied/modified/renamed; deleted files are excluded.
git diff --cached --name-only --diff-filter=ACMR -z -- '*.py' > "$STAGED_LIST"
staged=$(tr '\0' '\n' < "$STAGED_LIST")

if [ -n "$staged" ]; then
    count=$(printf '%s\n' "$staged" | grep -c .)
    echo "pre-commit: linting $count staged python file(s)..."

    # From inside the snapshot, so the paths ruff reports are the repo's own.
    (cd "$SNAPSHOT" && ruff_staged check --force-exclude) || fail=1
    (cd "$SNAPSHOT" && ruff_staged format --check --force-exclude) || fail=1
else
    echo "pre-commit: no staged python files to lint."
fi

if [ "$fail" -ne 0 ]; then
    echo >&2
    echo "pre-commit: BLOCKED — fix the problems above and re-stage." >&2
    echo "  lint autofix:    $RUFF check --fix <files>" >&2
    echo "  format autofix:  $RUFF format <files>" >&2
    echo "  missing module:  make sure you 'git add' it (check .gitignore too)" >&2
    exit 1
fi

echo "pre-commit: OK"
