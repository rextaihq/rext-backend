# Core app
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
REQUIRE_EMAIL_VERIFICATION=false
HOST=0.0.0.0
PORT=2024

# Scheduled jobs (billing, trial expiry, dunning, digests, scheduled publishing).
# Off on a local checkout so it never acts on accounts; deployed servers leave it unset (on).
SCHEDULER_ENABLED=false

# Security (must be >= 32 chars)
# Required, 32+ characters each, and different. Generate each with: openssl rand -hex 32
# Left empty so a copied example can't start a server with a known secret.
SECRET_KEY=
REFRESH_SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database / cache
# The values below are DEVELOPMENT.md's local setup ("Running locally").
POSTGRES_URI_CUSTOM=postgresql+asyncpg://rext:rext@localhost:5432/rext_app
# This is the connection string for the app engine and alembic
# (src/api/database/async_database.py). In deployed environments, Coolify
# overrides it with the direct database address (host:5432).
#
# DATABASE_URL is a different variable. It belongs to the LangGraph runtime,
# not to the app. The runtime reads it by name for its own database pool
# (checkpointer and store). It must always point directly to postgres
# (host:5432).
#
# WARNING: Never point DATABASE_URL to pgbouncer. The runtime's psycopg
# driver cannot connect through pgbouncer transaction mode. Doing this
# caused the staging outage on 2026-09-30 (container restart loop,
# "could not get a connection after 30 seconds" from pool-2).
#
# If the app engine ever needs to go through pgbouncer, create a new,
# separate variable for it. Do not reuse this one.
# DATABASE_URL=postgresql://rext:rext@localhost:5432/rext_app
#
# PGBOUNCER_HOST: both stacks ship a pgbouncer container (transaction mode,
# port 5432), but deployed environments currently bypass it and connect
# directly. Documented here for when that changes.
# PGBOUNCER_HOST=pgbouncer
#
# DATABASE_URI is the LangGraph runtime's database (threads, runs, checkpoints), recommended as
# a database of its own on the same server (DEVELOPMENT.md, "Databases").
DATABASE_URI=postgresql://rext:rext@localhost:5432/rext_app_runtime
REDIS_URL=redis://localhost:6379/0
# The LangGraph runtime's Redis (its task queue and the stream's pub/sub).
REDIS_URI=redis://localhost:6379/1
REDIS_MAX_CONNECTIONS=50
REFRESH_REPLAY_GRACE_SECONDS=60

# AI, search and SEO data. Each call costs money: a real generation run spends all three.
OPENAI_API_KEY=replace_with_openai_api_key
# Read by langchain-tavily from the environment (the research step's web search).
TAVILY_API_KEY=replace_with_tavily_api_key
# DataForSEO: the SERP and backlinks endpoints and the Basic auth header for both.
DATAFORSEO_AUTH_HEADER=
DATAFORSEO_SERP_URL=
DATAFORSEO_BACKLINKS_URL=
LANGSMITH_API_KEY=
LANGSMITH_DEV_URL=
# Feature flag: when false (default), the content agent still plans where an
# image belongs (art direction, alt text, placement) but never calls the paid
# image model: a manual-upload placeholder is embedded instead, for the user
# to fill in from the editor. Set true to re-enable real image generation.
AI_IMAGE_GENERATION_ENABLED=false

# The public free tools (/api/v1/tools/*, which the rext.ai site calls without a login), per UTC
# day: calls per visitor per tool that runs a model or not, and the most the model tools spend
# together, in US dollars (each call is charged its worst case first).
FREE_TOOLS_MODEL_CALLS_PER_DAY=20
FREE_TOOLS_CALLS_PER_DAY=100
FREE_TOOLS_DAILY_BUDGET_USD=5
# The model tools' bot check: Cloudflare Turnstile's secret key, for the token the site's forms send
# as `turnstile_token`. Unset, there's no check. Set it only once the site sends tokens: from then
# on, a model tool refuses a call without one.
TURNSTILE_SECRET_KEY=

# Shopify App Bridge
SHOPIFY_APP_SLUG=rext-publisher-1
SHOPIFY_APP_ENTRY_PATH=/app/blogpost
SHOPIFY_BRIDGE_BASE_URL=
SHOPIFY_BRIDGE_PUBLISH_ENDPOINT=/app/api/rext/publish
SHOPIFY_BRIDGE_SHARED_SECRET=

# Frontend / CORS
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Reverse proxy / client IP
# Comma-separated IPs of the reverse proxies (Traefik/Coolify) in front of the
# API. Only from these hops does ProxyHeadersMiddleware trust X-Forwarded-For to
# set the real client IP; all other clients keep their socket address. This is
# what makes the admin-managed account-creation IP allowlist safe from spoofing.
TRUSTED_PROXY_IPS=

# Email / Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=
RESEND_WEBHOOK_SECRET=

# Payments / LemonSqueezy
PAYMENT_SUCCESS_URL=http://localhost:3000/checkout/success
PAYMENT_CANCEL_URL=http://localhost:3000/checkout/cancel
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_SANDBOX_MODE=true
LEMONSQUEEZY_STORE_ID=

# Per-plan LemonSqueezy product/variant IDs. These are synced into the
# subscription_plans table automatically on app startup (see
# src/config/lemonsqueezy_plan_sync.py) - set the SAME variable names in
# every environment (local/stage/production), only the values differ
# between stage (test-mode store) and production (live-mode store).
# Optional per-plan LEMONSQUEEZY_<PLAN>_STORE_ID overrides the global
# LEMONSQUEEZY_STORE_ID above if a plan is sold from a different store.
LEMONSQUEEZY_STARTER_PRODUCT_ID=
LEMONSQUEEZY_STARTER_VARIANT_ID_MONTHLY=
LEMONSQUEEZY_STARTER_VARIANT_ID_YEARLY=

LEMONSQUEEZY_GROWTH_PRODUCT_ID=
LEMONSQUEEZY_GROWTH_VARIANT_ID_MONTHLY=
LEMONSQUEEZY_GROWTH_VARIANT_ID_YEARLY=

LEMONSQUEEZY_PRO_PRODUCT_ID=
LEMONSQUEEZY_PRO_VARIANT_ID_MONTHLY=
LEMONSQUEEZY_PRO_VARIANT_ID_YEARLY=

LEMONSQUEEZY_AGENCY_PRODUCT_ID=
LEMONSQUEEZY_AGENCY_VARIANT_ID_MONTHLY=
LEMONSQUEEZY_AGENCY_VARIANT_ID_YEARLY=

# Admin bootstrap
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=replace_with_secure_admin_password

# Monitoring
SENTRY_DSN=

# Encrypts stored integration sign-ins (WordPress, Shopify). Needed as soon as one is connected.
# One key as a rule; while a key is being changed, the new and the old, comma-separated, new first
# (scripts/rotate_field_encryption.py has the steps and re-encrypts what is stored).
FIELD_ENCRYPTION_KEY=

# ---- Generated by scripts/env_example.py from here on; edit the settings, not these lines ----
# Every other setting the code reads, with its default. A commented line is optional; a line
# without # has no default and must be set. Run `uv run python scripts/env_example.py` after
# changing a settings class; tests/unit/test_env_example.py fails while this part is stale.

# src/api/config.py (Settings)
# Apply the pending Alembic migrations before serving (the image sets it)
# MIGRATE_ON_START=false
# Local-only override for workspace limit testing; requires ENVIRONMENT=local
# LOCAL_UNLIMITED_WORKSPACES=false
# API key for service authentication
# API_KEY=
# API key header name
# API_KEY_NAME=X-API-Key
# The key the dashboard's server sends with its Google and GitHub sign-in call (header X-Rext-Dashboard-Key); the same value on both services, at least 32 characters
# DASHBOARD_SERVER_KEY=
# Refuse a Google or GitHub sign-in call that does not carry DASHBOARD_SERVER_KEY; switch on once the dashboard sends it
# REQUIRE_DASHBOARD_SERVER_KEY=
# Maximum failed login attempts before lockout
# AUTH_MAX_LOGIN_ATTEMPTS=5
# Account lockout duration in hours
# AUTH_LOCKOUT_DURATION_HOURS=1
# Days to retain soft-deleted users before permanent purge
# USER_DELETION_RETENTION_DAYS=14
# SQLAlchemy connection pool size per engine
# POSTGRES_POOL_SIZE=10
# Max overflow connections beyond pool_size
# POSTGRES_MAX_OVERFLOW=15
# Seconds to wait for a pool connection before timeout
# POSTGRES_POOL_TIMEOUT=30
# Seconds before a connection is recycled
# POSTGRES_POOL_RECYCLE=280
# Enable Redis caching
# CACHE_ENABLED=true
# Default cache TTL in seconds (5 minutes)
# CACHE_DEFAULT_TTL=300
# Public backend base URL, used to generate absolute callback URLs
# BACKEND_URL=
# Staging/development only: also accept the dashboard's Vercel preview origins (CORS)
# ALLOW_PREVIEW_ORIGINS=false
# Comma-separated list of allowed CORS request headers
# CORS_ALLOWED_HEADERS=Authorization,Content-Type,Accept,X-Request-ID,X-API-Key
# Rate limit: requests per minute
# RATE_LIMIT_PER_MINUTE=1000
# Rate limit: requests per hour
# RATE_LIMIT_PER_HOUR=10000
# Rate limit: requests per day
# RATE_LIMIT_PER_DAY=100000
# Enable rate limiting
# RATE_LIMITING_ENABLED=true
# SMTP server address
# SMTP_SERVER=
# SMTP server port
# SMTP_PORT=587
# Shopify app client ID / API key used for OAuth installation
# SHOPIFY_API_KEY=
# Shopify app client secret used for OAuth installation
# SHOPIFY_API_SECRET=
# Comma-separated Shopify OAuth scopes requested during installation
# SHOPIFY_APP_SCOPES=read_products,write_content
# Backend callback path registered in the Shopify app setup
# SHOPIFY_INSTALL_CALLBACK_PATH=/api/routes/integrations/shopify/install/callback
# Frontend path to redirect to after Shopify installation completes
# SHOPIFY_INTEGRATION_RETURN_PATH=/integrations
# Lowest severity persisted to error_logs and shown in the admin Error Logs tab. One of: warning, error, critical (the previous release's medium/high are still accepted and normalised).
# ERROR_LOG_MIN_SEVERITY=medium
# Record logger.error/logger.critical calls from anywhere in the application as error_logs rows. Most failures are caught, logged and recovered from rather than raised, so without this they exist only in stdout. Deduplicated per module and message.
# ERROR_LOG_CAPTURE_LOGGED_ERRORS=true
# Minimum seconds between recorded failures for the same infrastructure dependency. A dependency that is down fails on every request, so this stops one outage from burying every other error on the dashboard.
# ERROR_LOG_DEPENDENCY_THROTTLE_SECONDS=300
# Maximum number of invalid fields recorded on a single validation error. Bounds the stored metadata so one request rejecting hundreds of fields cannot write an unbounded row.
# ERROR_LOG_MAX_VALIDATION_FIELDS=20
# Request paths whose errors are not persisted. The monitoring endpoints are excluded so a failure there cannot fill the very table an operator is reading to diagnose it.
# ERROR_LOG_EXCLUDED_PATH_PREFIXES=["/api/v1/admin/monitoring"]
# Request paths excluded from API usage counters. The monitoring dashboard polls itself, so counting it makes the metric measure the act of looking at it.
# METRICS_EXCLUDED_PATH_PREFIXES=["/api/v1/admin/monitoring"]
# Timezone used to align reporting periods to calendar days, so '7 days' means seven whole local days rather than a rolling 168h.
# REPORTING_TIMEZONE=UTC
# Sentry environment name (defaults to ENVIRONMENT if not set)
# SENTRY_ENVIRONMENT=
# Sentry performance monitoring sample rate (0.0-1.0)
# SENTRY_TRACES_SAMPLE_RATE=0.1
# Sentry profiling sample rate (0.0-1.0)
# SENTRY_PROFILES_SAMPLE_RATE=0.1
# Enable Sentry performance tracing
# SENTRY_ENABLE_TRACING=true
# Send personally identifiable information to Sentry
# SENTRY_SEND_DEFAULT_PII=false
# Maximum number of breadcrumbs to send
# SENTRY_MAX_BREADCRUMBS=50
# Enable Sentry debug mode (verbose logging)
# SENTRY_DEBUG=false
# Attach stack traces to all messages
# SENTRY_ATTACH_STACKTRACE=true
# Sentry release identifier (e.g., git commit SHA)
# SENTRY_RELEASE=
# Directory for uploaded files
# UPLOAD_DIR=/app/secure_uploads
# Maximum file upload size in MB
# MAX_UPLOAD_SIZE_MB=10
# Maximum image width in pixels
# MAX_IMAGE_WIDTH=4096
# Maximum image height in pixels
# MAX_IMAGE_HEIGHT=4096
# Minimum image width in pixels
# MIN_IMAGE_WIDTH=10
# Minimum image height in pixels
# MIN_IMAGE_HEIGHT=10
# Comma-separated list of allowed MIME types for file uploads
# ALLOWED_MIME_TYPES   (its default is computed in src/api/config.py)
# Enable virus scanning for uploaded files
# VIRUS_SCAN_ENABLED=false
# Virus scanning method: 'clamav', 'virustotal', or 'none'
# VIRUS_SCAN_METHOD=none
# VirusTotal API key (required if VIRUS_SCAN_METHOD=virustotal)
# VIRUSTOTAL_API_KEY=
# ClamAV daemon host
# CLAMAV_HOST=localhost
# ClamAV daemon port
# CLAMAV_PORT=3310
# Absolute path to the clamdscan binary
# CLAMAV_BINARY_PATH=/usr/bin/clamdscan
# Behavior when virus scanner is unavailable: 'closed' (reject upload) or 'open' (allow upload). Production should always use 'closed'. Use 'open' only for development/testing.
# VIRUS_SCAN_FAIL_BEHAVIOR=closed
# Free tier: max file size in MB
# TIER_FREE_MAX_FILE_SIZE_MB=10
# Pro tier: max file size in MB
# TIER_PRO_MAX_FILE_SIZE_MB=50
# Enterprise tier: max file size in MB
# TIER_ENTERPRISE_MAX_FILE_SIZE_MB=200
# Free tier: max total storage in MB
# TIER_FREE_MAX_STORAGE_MB=100
# Pro tier: max total storage in MB (1GB)
# TIER_PRO_MAX_STORAGE_MB=1024
# Enterprise tier: max total storage in MB (10GB)
# TIER_ENTERPRISE_MAX_STORAGE_MB=10240
# MinIO/S3 endpoint
# MINIO_ENDPOINT=localhost:9000
# MinIO/S3 access key; the default is the store's stock one, for a laptop only
# MINIO_ACCESS_KEY=
# MinIO/S3 secret key; the default is the store's stock one, for a laptop only
# MINIO_SECRET_KEY=
# MinIO/S3 bucket name
# MINIO_BUCKET=rext-media
# Use SSL for MinIO/S3 connection
# MINIO_USE_SSL=false
# Public URL for accessing MinIO files (e.g. via CDN or reverse proxy)
# MINIO_PUBLIC_URL=

# src/config/cleanup_config.py (CleanupConfig)
# AUDIT_LOG_RETENTION_DAYS=365
# EMAIL_LOG_RETENTION_DAYS=30
# EMAIL_EVENT_RETENTION_DAYS=30
# ERROR_LOG_RETENTION_DAYS=90
# USER_SESSION_INACTIVE_DAYS=7
# WEBHOOK_EVENT_RETENTION_DAYS=90
# CANCELLED_SUBSCRIPTION_RETENTION_DAYS=90
# CLEANUP_ENABLED=true
# BILLING_TASKS_ENABLED=true
# TRIAL_TASKS_ENABLED=true
# DIGEST_TASKS_ENABLED=true
# INVITATION_REMINDERS_ENABLED=true
# WEBHOOK_REPROCESS_TASKS_ENABLED=true
# SUBSCRIPTION_RECONCILE_ENABLED=true
# API_USAGE_ROLLUP_INTERVAL_MINUTES=10
# CLEANUP_HOUR=2
# CLEANUP_MINUTE=0
# DIGEST_HOUR=8
# DIGEST_MINUTE=0
# INVITATION_REMINDER_HOUR=9
# INVITATION_REMINDER_MINUTE=0
# CLEANUP_BATCH_SIZE=1000
# CLEANUP_DRY_RUN=true
# SCHEDULED_PUBLISH_MAX_RETRIES=3
# SCHEDULED_PUBLISH_RETRY_INTERVAL_MINUTES=3
# WEBHOOK_REPROCESS_MAX_RETRIES=5
# WEBHOOK_REPROCESS_BACKOFF_MINUTES=15
# WEBHOOK_REPROCESS_INTERVAL_MINUTES=10
# WEBHOOK_REPROCESS_BATCH_LIMIT=25
# WEBHOOK_REPROCESS_LOOKBACK_HOURS=72

# src/config/email_config.py (EmailConfig)
# EMAIL_PROVIDER=resend
# EMAIL_FALLBACK_PROVIDER=
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_USE_TLS=true
# EMAIL_RETRY_ENABLED=true
# EMAIL_RETRY_MAX_ATTEMPTS=3
# EMAIL_RETRY_DELAY_SECONDS=5
# EMAIL_ENABLED=true

# src/config/payment_config.py (PaymentSettings)
# PAYMENT_PROVIDER=lemonsqueezy
# PAYMENT_SANDBOX_MODE=true
# PAYMENT_CURRENCY=USD
# WEBHOOK_IP_VALIDATION_ENABLED=false
# LEMONSQUEEZY_WEBHOOK_IPS=159.223.172.0/24

# src/config/storage_config.py (StorageSettings)
# storage_backend=local
# r2_bucket=
# r2_account_id=
# r2_access_key_id=
# r2_secret_access_key=
# r2_public_domain=
# local_storage_path   (its default is computed in src/config/storage_config.py)
# local_storage_url_base=/media
# max_file_size=20971520
# max_image_size=10485760
# max_video_size=104857600
# presigned_url_expiration=3600
# presigned_url_max_expiration=604800
# thumbnail_url_expiration=86400

# Read directly (os.getenv / os.environ)
# ANALYTICS_INTERNAL_DOMAINS=revnix.com   (src/services/server_events.py)
# API_BASE_URL=http://localhost:2024   (scripts/test_checkout_flow.py)
# BILLING_AUTO_SETTLE_DUPLICATES=false   (src/services/duplicate_subscriptions.py)
# KEY_ROTATION_POLICY_DAYS=90   (scripts/check_key_rotation_schedule.py)
# KEY_ROTATION_URGENT_DAYS=7   (scripts/check_key_rotation_schedule.py)
# KEY_ROTATION_WARNING_DAYS=30   (scripts/check_key_rotation_schedule.py)
# POSTHOG_HOST=   (src/services/money_events.py)
# POSTHOG_PROJECT_KEY=   (src/services/account_events.py)
# REXT_STORAGE_SKIP_BUCKET_CHECK=   (src/utils/storage.py)
# SUPER_ADMIN_FIRST_NAME=Super   (scripts/seeds/seed_super_admin.py)
# SUPER_ADMIN_LAST_NAME=Admin   (scripts/seeds/seed_super_admin.py)

# Per plan (src/config/lemonsqueezy_plan_config.py); a plan's STORE_ID falls back to
# LEMONSQUEEZY_STORE_ID when it's sold from the same store
# LEMONSQUEEZY_STARTER_STORE_ID=
# LEMONSQUEEZY_GROWTH_STORE_ID=
# LEMONSQUEEZY_PRO_STORE_ID=
# LEMONSQUEEZY_AGENCY_STORE_ID=
