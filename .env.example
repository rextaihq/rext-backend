# Core app
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
REQUIRE_EMAIL_VERIFICATION=false
HOST=0.0.0.0
PORT=2024

# Security (must be >= 32 chars)
SECRET_KEY=replace_with_32_plus_characters_secret_key
REFRESH_SECRET_KEY=replace_with_32_plus_characters_refresh_secret_key
ALGORITHM=HS256

# Database / cache
POSTGRES_URI_CUSTOM=postgresql+asyncpg://exec:rextserver@localhost:5433/rext
REDIS_URL=redis://localhost:6379/0
REDIS_URI=redis://langgraph-redis:6379

# AI providers
OPENAI_API_KEY=replace_with_openai_api_key
GNEWS_API_KEY=replace_with_gnews_api_key
LANGSMITH_API_KEY=replace_with_langsmith_api_key
LANGSMITH_DEV_URL=
PERPLEXITY_API_KEY=
SERPER_API_KEY=

# WordPress
WP_URL=https://example.com/wp-json/wp/v2/posts
WP_TOKEN=replace_with_wordpress_token

# Shopify App Bridge
SHOPIFY_APP_SLUG=rext-publisher-1
SHOPIFY_APP_ENTRY_PATH=/app/blogpost
SHOPIFY_BRIDGE_BASE_URL=
SHOPIFY_BRIDGE_PUBLISH_ENDPOINT=/app/api/rext/publish
SHOPIFY_BRIDGE_SHARED_SECRET=

# Google Search Console / GA4 (OAuth 2.0 — see docs for Google Cloud setup steps)
GOOGLE_CLIENT_ID=replace_with_google_oauth_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_oauth_client_secret
GOOGLE_OAUTH_SCOPES=openid email https://www.googleapis.com/auth/webmasters.readonly https://www.googleapis.com/auth/analytics.readonly
GOOGLE_OAUTH_CALLBACK_PATH=/api/v1/integrations/google/callback
GOOGLE_INTEGRATION_RETURN_PATH=/integrations
GOOGLE_SYNC_ENABLED=true
GOOGLE_SYNC_INTERVAL_HOURS=6
GOOGLE_SYNC_LOOKBACK_DAYS=7
GOOGLE_INDEX_INSPECTION_ENABLED=true
GOOGLE_INDEX_INSPECTION_INTERVAL_HOURS=24
GOOGLE_INDEX_INSPECTION_DAILY_QUOTA_PER_SITE=200
GOOGLE_INDEX_INSPECTION_PER_MINUTE_LIMIT=300

# Frontend / CORS
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Email / Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=
RESEND_WEBHOOK_SECRET=

# Payments / LemonSqueezy
PAYMENT_SUCCESS_URL=http://localhost:3000/checkout/success
PAYMENT_CANCEL_URL=http://localhost:3000/checkout/cancel
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_SANDBOX_MODE=true
LEMONSQUEEZY_STORE_ID=

# Admin bootstrap
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=replace_with_secure_admin_password

# Monitoring
SENTRY_DSN=

# Optional encryption key
FIELD_ENCRYPTION_KEY=
