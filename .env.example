# ============================================================================
# WREXT Backend Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control (it contains secrets)
# ============================================================================

# ----------------------------------------------------------------------------
# Super Admin Configuration (Database Seeding)
# ----------------------------------------------------------------------------
# These credentials are used ONLY during database migration to create the
# initial super admin account. Set these before running: alembic upgrade head
#
# Required:
SUPER_ADMIN_EMAIL=admin@yourdomain.com
SUPER_ADMIN_PASSWORD=your-secure-password-here

# Optional (defaults shown):
SUPER_ADMIN_FIRST_NAME=Super
SUPER_ADMIN_LAST_NAME=Admin
#
# SECURITY NOTE: After initial setup, you can remove these from .env
# The super admin account will remain in the database
# ----------------------------------------------------------------------------

# ----------------------------------------------------------------------------
# Database Configuration
# ----------------------------------------------------------------------------
POSTGRES_URI_CUSTOM=postgresql://username:password@host:port/database
# Example: postgresql://user:pass@localhost:5432/wrext_db

# ----------------------------------------------------------------------------
# Redis Configuration (for LangGraph)
# ----------------------------------------------------------------------------
REDIS_URI=redis://localhost:6379

# ----------------------------------------------------------------------------
# JWT & Authentication (REQUIRED - DO NOT USE PLACEHOLDER VALUES)
# ----------------------------------------------------------------------------
# IMPORTANT: Generate secure keys using: python scripts/generate_jwt_secret.py
#
# Requirements:
#   - SECRET_KEY: Minimum 32 characters (64+ recommended)
#   - REFRESH_SECRET_KEY: Minimum 32 characters (64+ recommended)
#   - MUST be different from each other
#   - MUST be cryptographically random (use the generation script)
#   - NEVER use placeholder values in production
#
# To generate new keys:
#   cd wrext-backend
#   python scripts/generate_jwt_secret.py
#
# Then copy the generated values below:
SECRET_KEY=REPLACE_WITH_GENERATED_SECRET_KEY_AT_LEAST_32_CHARS
REFRESH_SECRET_KEY=REPLACE_WITH_GENERATED_REFRESH_SECRET_KEY_AT_LEAST_32_CHARS
ALGORITHM=HS256
#
# Optional: Token expiration settings (defaults shown)
# ACCESS_TOKEN_EXPIRE_MINUTES=1440  # 24 hours
# REFRESH_TOKEN_EXPIRE_DAYS=7       # 7 days
#
# Security Notes:
#   - Application will FAIL TO START if keys are too short or invalid
#   - Rotate keys periodically (see docs/security/key-rotation.md)
#   - Use different keys for development, staging, and production
#   - If keys are compromised, regenerate immediately
# ----------------------------------------------------------------------------

# ----------------------------------------------------------------------------
# API Keys
# ----------------------------------------------------------------------------
API_KEY_NAME=content-api-key
API_KEY=your-api-key-here

# OpenAI
OPENAI_API_KEY=sk-proj-your-key-here

# GNews
GNEWS_API_KEY=your-gnews-key-here

# Tavily
TAVILY_API_KEY=tvly-your-key-here

# Perplexity
PERPLEXITY_API_KEY=pplx-your-key-here

# LangSmith (for tracing)
LANGSMITH_API_KEY=lsv2_your-key-here
LANGSMITH_PROJECT=WREXT
LANGSMITH_TRACING=true

# WordPress (if using WP integration)
# WP_URL=https://yourwordpress.com/wp-json/wp/v2/posts
# WP_TOKEN=your-jwt-token-here

# ----------------------------------------------------------------------------
# Frontend & CORS Configuration
# ----------------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ENVIRONMENT=development
DEBUG=false

# ----------------------------------------------------------------------------
# Rate Limiting Configuration
# ----------------------------------------------------------------------------
RATE_LIMITING_ENABLED=true
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_PER_HOUR=1000
RATE_LIMIT_PER_DAY=10000

# ----------------------------------------------------------------------------
# Email Service (Resend)
# ----------------------------------------------------------------------------
RESEND_API_KEY=re_your_key_here
FROM_EMAIL=noreply@yourdomain.com
REPLY_TO_EMAIL=support@yourdomain.com
#
# Resend Webhook Configuration
# Get this from Resend Dashboard → Webhooks when adding webhook endpoint
# Webhook URL: https://yourdomain.com/api/v1/email/webhooks/resend
RESEND_WEBHOOK_SECRET=whsec_your_resend_webhook_secret_here

# ----------------------------------------------------------------------------
# Payment Provider
# ----------------------------------------------------------------------------
# LemonSqueezy (Recommended)
# Get keys from: https://app.lemonsqueezy.com/settings/api
# LEMONSQUEEZY_API_KEY=your_api_key_here
# LEMONSQUEEZY_STORE_ID=your_store_id_here
#
# LemonSqueezy Webhook Configuration
# IMPORTANT: Required for production to verify webhook signatures
# Get this from LemonSqueezy Dashboard → Settings → Webhooks
# Webhook URL: https://yourdomain.com/api/v1/subscriptions/webhooks/lemonsqueezy
# Events to subscribe to: subscription_*, order_created
# LEMONSQUEEZY_WEBHOOK_SECRET=your_lemonsqueezy_webhook_signing_secret

# ----------------------------------------------------------------------------
# Alternative Payment Providers (Optional)
# ----------------------------------------------------------------------------
# Stripe
# STRIPE_SECRET_KEY=sk_test_your_key_here
# STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
# STRIPE_WEBHOOK_SECRET=whsec_your_secret_here

# Paddle
# PADDLE_API_KEY=your_paddle_api_key
# PADDLE_WEBHOOK_SECRET=your_paddle_webhook_secret

# FastSpring
# FASTSPRING_USERNAME=your_username
# FASTSPRING_PASSWORD=your_password
# FASTSPRING_WEBHOOK_SECRET=your_webhook_secret

# ----------------------------------------------------------------------------
# Optional: Sentry (Error Tracking)
# ----------------------------------------------------------------------------
# SENTRY_DSN=https://your-sentry-dsn-here

# ----------------------------------------------------------------------------
# Optional: S3-Compatible Storage (for media uploads)
# ----------------------------------------------------------------------------
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_S3_BUCKET=your-bucket-name
# AWS_REGION=us-east-1
