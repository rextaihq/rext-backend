# ============================================================================
# WREXT Backend Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control (it contains secrets)
# ============================================================================

# ----------------------------------------------------------------------------
# Super Admin Configuration (Database Seeding)
# ----------------------------------------------------------------------------
# These credentials are used ONLY during database migration to create the
# initial super admin account. Set these before running: alembic upgrade head
#
# Required:
SUPER_ADMIN_EMAIL=admin@yourdomain.com
SUPER_ADMIN_PASSWORD=your-secure-password-here

# Optional (defaults shown):
SUPER_ADMIN_FIRST_NAME=Super
SUPER_ADMIN_LAST_NAME=Admin
#
# SECURITY NOTE: After initial setup, you can remove these from .env
# The super admin account will remain in the database
# ----------------------------------------------------------------------------

# ----------------------------------------------------------------------------
# Database Configuration
# ----------------------------------------------------------------------------
POSTGRES_URI_CUSTOM=postgresql://username:password@host:port/database
# Example: postgresql://user:pass@localhost:5432/wrext_db

# ----------------------------------------------------------------------------
# Redis Configuration (for LangGraph)
# ----------------------------------------------------------------------------
REDIS_URI=redis://localhost:6379

# ----------------------------------------------------------------------------
# JWT & Authentication
# ----------------------------------------------------------------------------
SECRET_KEY=your-secret-key-here-for-jwt-tokens-should-be-long-and-random
REFRESH_SECRET_KEY=your-refresh-secret-key-here-different-from-secret-key
ALGORITHM=HS256

# ----------------------------------------------------------------------------
# API Keys
# ----------------------------------------------------------------------------
API_KEY_NAME=content-api-key
API_KEY=your-api-key-here

# OpenAI
OPENAI_API_KEY=sk-proj-your-key-here

# GNews
GNEWS_API_KEY=your-gnews-key-here

# Tavily
TAVILY_API_KEY=tvly-your-key-here

# Perplexity
PERPLEXITY_API_KEY=pplx-your-key-here

# LangSmith (for tracing)
LANGSMITH_API_KEY=lsv2_your-key-here
LANGSMITH_PROJECT=WREXT
LANGSMITH_TRACING=true

# WordPress (if using WP integration)
# WP_URL=https://yourwordpress.com/wp-json/wp/v2/posts
# WP_TOKEN=your-jwt-token-here

# ----------------------------------------------------------------------------
# Frontend & CORS Configuration
# ----------------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ENVIRONMENT=development
DEBUG=false

# ----------------------------------------------------------------------------
# Rate Limiting Configuration
# ----------------------------------------------------------------------------
RATE_LIMITING_ENABLED=true
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_PER_HOUR=1000
RATE_LIMIT_PER_DAY=10000

# ----------------------------------------------------------------------------
# Email Service (Resend)
# ----------------------------------------------------------------------------
RESEND_API_KEY=re_your_key_here
FROM_EMAIL=noreply@yourdomain.com
REPLY_TO_EMAIL=support@yourdomain.com

# ----------------------------------------------------------------------------
# Payment Provider (choose one)
# ----------------------------------------------------------------------------
# Stripe (recommended - Plan 01A)
# STRIPE_SECRET_KEY=sk_test_your_key_here
# STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
# STRIPE_WEBHOOK_SECRET=whsec_your_secret_here

# Paddle (Plan 01A alternative)
# PADDLE_API_KEY=your_paddle_api_key
# PADDLE_WEBHOOK_SECRET=your_paddle_webhook_secret

# FastSpring (Plan 01B)
# FASTSPRING_USERNAME=your_username
# FASTSPRING_PASSWORD=your_password
# FASTSPRING_WEBHOOK_SECRET=your_webhook_secret

# ----------------------------------------------------------------------------
# Optional: Sentry (Error Tracking)
# ----------------------------------------------------------------------------
# SENTRY_DSN=https://your-sentry-dsn-here

# ----------------------------------------------------------------------------
# Optional: S3-Compatible Storage (for media uploads)
# ----------------------------------------------------------------------------
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_S3_BUCKET=your-bucket-name
# AWS_REGION=us-east-1
