# ============================================================================
# WREXT Backend Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control (it contains secrets)
# ============================================================================

# ----------------------------------------------------------------------------
# Super Admin Configuration (Database Seeding)
# ----------------------------------------------------------------------------
# These credentials are used ONLY during database migration to create the
# initial super admin account. Set these before running: alembic upgrade head
#
# Required:
SUPER_ADMIN_EMAIL=admin@yourdomain.com
SUPER_ADMIN_PASSWORD=your-secure-password-here

# Optional (defaults shown):
SUPER_ADMIN_FIRST_NAME=Super
SUPER_ADMIN_LAST_NAME=Admin
#
# SECURITY NOTE: After initial setup, you can remove these from .env
# The super admin account will remain in the database
# ----------------------------------------------------------------------------

# ----------------------------------------------------------------------------
# Database Configuration
# ----------------------------------------------------------------------------
POSTGRES_URI_CUSTOM=postgresql://username:password@host:port/database
# Example: postgresql://user:pass@localhost:5432/wrext_db

# ----------------------------------------------------------------------------
# Redis Configuration
# ----------------------------------------------------------------------------
# Redis URL for caching and LangGraph
REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=true
CACHE_DEFAULT_TTL=300

# ----------------------------------------------------------------------------
# JWT & Authentication (REQUIRED - DO NOT USE PLACEHOLDER VALUES)
# ----------------------------------------------------------------------------
# IMPORTANT: Generate secure keys using: python scripts/generate_jwt_secret.py
#
# Requirements:
#   - SECRET_KEY: Minimum 32 characters (64+ recommended)
#   - REFRESH_SECRET_KEY: Minimum 32 characters (64+ recommended)
#   - MUST be different from each other
#   - MUST be cryptographically random (use the generation script)
#   - NEVER use placeholder values in production
#
# To generate new keys:
#   cd wrext-backend
#   python scripts/generate_jwt_secret.py
#
# Then copy the generated values below:
SECRET_KEY=REPLACE_WITH_GENERATED_SECRET_KEY_AT_LEAST_32_CHARS
REFRESH_SECRET_KEY=REPLACE_WITH_GENERATED_REFRESH_SECRET_KEY_AT_LEAST_32_CHARS
ALGORITHM=HS256
#
# Optional: Token expiration settings (defaults shown)
# ACCESS_TOKEN_EXPIRE_MINUTES=1440  # 24 hours
# REFRESH_TOKEN_EXPIRE_DAYS=7       # 7 days
#
# Auth Security Settings (defaults shown)
# AUTH_MAX_LOGIN_ATTEMPTS=3           # Failed login attempts before lockout
# AUTH_LOCKOUT_DURATION_HOURS=1       # Account lockout duration
#
# Security Notes:
#   - Application will FAIL TO START if keys are too short or invalid
#   - Rotate keys periodically (see docs/security/key-rotation.md)
#   - Use different keys for development, staging, and production
#   - If keys are compromised, regenerate immediately
# ----------------------------------------------------------------------------

# ----------------------------------------------------------------------------
# API Keys
# ----------------------------------------------------------------------------
API_KEY_NAME=content-api-key
API_KEY=your-api-key-here

# OpenAI
OPENAI_API_KEY=sk-proj-your-key-here

# GNews
GNEWS_API_KEY=your-gnews-key-here

# Tavily
TAVILY_API_KEY=tvly-your-key-here

# Perplexity
PERPLEXITY_API_KEY=pplx-your-key-here

# LangSmith (for tracing)
LANGSMITH_API_KEY=lsv2_your-key-here
LANGSMITH_DEV_URL=https://api.smith.langchain.com
LANGSMITH_PROJECT=WREXT
LANGSMITH_TRACING=true

# WordPress (if using WP integration)
# WP_URL=https://yourwordpress.com/wp-json/wp/v2/posts
# WP_TOKEN=your-jwt-token-here

# ----------------------------------------------------------------------------
# Frontend & CORS Configuration
# ----------------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# ----------------------------------------------------------------------------
# Server Configuration
# ----------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000

# ----------------------------------------------------------------------------
# Rate Limiting Configuration
# ----------------------------------------------------------------------------
RATE_LIMITING_ENABLED=true
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_PER_HOUR=1000
RATE_LIMIT_PER_DAY=10000

# ----------------------------------------------------------------------------
# Email Service (Resend - Recommended)
# ----------------------------------------------------------------------------
RESEND_API_KEY=re_your_key_here
FROM_EMAIL=noreply@yourdomain.com
REPLY_TO_EMAIL=support@yourdomain.com
#
# Resend Webhook Configuration
# Get this from Resend Dashboard → Webhooks when adding webhook endpoint
# Webhook URL: https://yourdomain.com/api/v1/email/webhooks/resend
RESEND_WEBHOOK_SECRET=whsec_your_resend_webhook_secret_here

# ----------------------------------------------------------------------------
# SMTP Email (Legacy/Fallback - Optional)
# ----------------------------------------------------------------------------
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# EMAIL_ADDRESS=your-email@gmail.com
# EMAIL_PASSWORD=your-app-password

# ----------------------------------------------------------------------------
# Payment Provider
# ----------------------------------------------------------------------------
# LemonSqueezy (Recommended)
# Get keys from: https://app.lemonsqueezy.com/settings/api
# LEMONSQUEEZY_API_KEY=your_api_key_here
# LEMONSQUEEZY_STORE_ID=your_store_id_here
#
# LemonSqueezy Webhook Configuration
# IMPORTANT: Required for production to verify webhook signatures
# Get this from LemonSqueezy Dashboard → Settings → Webhooks
# Webhook URL: https://yourdomain.com/api/v1/subscriptions/webhooks/lemonsqueezy
# Events to subscribe to: subscription_*, order_created
# LEMONSQUEEZY_WEBHOOK_SECRET=your_lemonsqueezy_webhook_signing_secret

# ----------------------------------------------------------------------------
# Monitoring & Observability - Sentry (Error Tracking & Performance)
# ----------------------------------------------------------------------------
# Sentry provides real-time error monitoring, performance tracking, and alerting.
# Sign up at https://sentry.io and create a project to get your DSN.
#
# Leave SENTRY_DSN empty to disable Sentry monitoring.
SENTRY_DSN=

# Environment identifier (defaults to ENVIRONMENT if not set)
# Options: development, staging, production
SENTRY_ENVIRONMENT=production

# Performance Monitoring - Sample rate for transaction tracing (0.0 to 1.0)
# Production recommendation: 0.1 (10%) to balance visibility and cost
# Development: 1.0 (100%) for full visibility
SENTRY_TRACES_SAMPLE_RATE=0.1

# Profiling sample rate (0.0 to 1.0) - Advanced performance diagnostics
SENTRY_PROFILES_SAMPLE_RATE=0.1

# Enable/disable performance tracing
SENTRY_ENABLE_TRACING=true

# Send Personally Identifiable Information (PII) to Sentry
# WARNING: Set to false for GDPR/CCPA compliance unless you have proper consent
# When false: user IDs are sent, but emails/usernames are not
SENTRY_SEND_DEFAULT_PII=false

# Maximum breadcrumbs per event (debugging context)
# SENTRY_MAX_BREADCRUMBS=50

# Enable Sentry debug logging (verbose SDK logs)
# SENTRY_DEBUG=false

# Attach stack traces to all messages
# SENTRY_ATTACH_STACKTRACE=true

# Release identifier (e.g., git commit SHA) - Enables release tracking
# Example: export SENTRY_RELEASE=$(git rev-parse HEAD)
# SENTRY_RELEASE=

# Setup Instructions:
# 1. Create account at https://sentry.io
# 2. Create new project: "wrext-backend" (Platform: Python/FastAPI)
# 3. Copy DSN from project settings and paste above
# 4. Deploy and monitor errors in Sentry dashboard
#
# Cost: Free tier includes 5K errors/month, paid plans start at $26/month

# ----------------------------------------------------------------------------
# File Upload Configuration
# ----------------------------------------------------------------------------
UPLOAD_DIR=/app/secure_uploads
MAX_UPLOAD_SIZE_MB=10

# Image validation (defaults shown)
# MAX_IMAGE_WIDTH=4096
# MAX_IMAGE_HEIGHT=4096
# MIN_IMAGE_WIDTH=10
# MIN_IMAGE_HEIGHT=10

# ----------------------------------------------------------------------------
# File Upload Security
# ----------------------------------------------------------------------------
# MIME types allowed for upload (comma-separated)
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/gif,image/webp,application/pdf,text/plain,text/markdown

# Virus scanning (optional - requires ClamAV or VirusTotal)
VIRUS_SCAN_ENABLED=false
VIRUS_SCAN_METHOD=none  # Options: clamav, virustotal, none

# VirusTotal API (if using VIRUS_SCAN_METHOD=virustotal)
# Sign up at: https://www.virustotal.com/gui/join-us
# VIRUSTOTAL_API_KEY=your_virustotal_api_key

# ClamAV daemon (if using VIRUS_SCAN_METHOD=clamav)
# Install: sudo apt-get install clamav clamav-daemon
# CLAMAV_HOST=localhost
# CLAMAV_PORT=3310

# Subscription Tier Limits - File Size (MB)
TIER_FREE_MAX_FILE_SIZE_MB=10
TIER_PRO_MAX_FILE_SIZE_MB=50
TIER_ENTERPRISE_MAX_FILE_SIZE_MB=200

# Subscription Tier Limits - Total Storage (MB)
TIER_FREE_MAX_STORAGE_MB=100        # 100MB
TIER_PRO_MAX_STORAGE_MB=1024        # 1GB
TIER_ENTERPRISE_MAX_STORAGE_MB=10240  # 10GB

# ----------------------------------------------------------------------------
# Optional: S3-Compatible Storage (for media uploads)
# ----------------------------------------------------------------------------
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_S3_BUCKET=your-bucket-name
# AWS_REGION=us-east-1
