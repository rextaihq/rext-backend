# Local development image only — production images are built by `langgraph build`
# from langgraph.json (see .github/workflows). Nothing here ships to staging or main.
#
# The virtualenv deliberately lives at /opt/venv, OUTSIDE the /app working
# directory, because docker-compose.dev.yml bind-mounts the repo over /app. A
# venv inside /app would be shadowed by that mount and the container would start
# with no dependencies installed.
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    PATH="/opt/venv/bin:$PATH"

# libpq5 for psycopg, build-essential for any sdist that needs compiling,
# curl for the healthcheck.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        curl \
        libpq5 \
    && rm -rf /var/lib/apt/lists/*

# uv from PyPI rather than COPY --from=ghcr.io/astral-sh/uv. ghcr.io serves its
# blobs from pkg-containers.githubusercontent.com, which does not resolve on
# every network the team works from; PyPI is reachable everywhere we have tried.
RUN pip install --no-cache-dir uv==0.5.11

WORKDIR /app

# Dependencies are baked into the image and cached on their own layer, so a
# source edit never triggers a reinstall. --no-install-project keeps the app
# itself out of the venv: it is imported from the bind-mounted /app instead,
# which is what makes hot reload work.
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-install-project

# Mirrors the "dockerfile_lines" block in langgraph.json, which the production
# image runs on Wolfi/apk. Without these, any crawl4ai or Playwright code path
# works in staging and fails only on developer machines. --with-deps pulls the
# system libraries Chromium needs, replacing the apk line used in production.
# Set INSTALL_BROWSERS=0 to skip the Chromium download entirely — useful where
# the Playwright CDN is unreachable, since a blocked host does not fail fast, it
# hangs until TCP times out and the build appears frozen. The timeouts below cap
# that at a few minutes instead of leaving it wedged.
ARG INSTALL_BROWSERS=1

RUN uv pip install --python /opt/venv/bin/python playwright crawl4ai \
    && playwright install-deps chromium \
    && if [ "$INSTALL_BROWSERS" = "1" ]; then \
         timeout 300 playwright install chromium \
           || echo "WARNING: Chromium download failed or timed out. Python packages are installed and imports resolve, but launching a browser will not work. Rebuild with network access, or see LOCAL-DEV.md."; \
         timeout 300 crawl4ai-setup || true; \
       else \
         echo "INSTALL_BROWSERS=0 — skipping Chromium download. Crawling code paths will not run in this image."; \
       fi

EXPOSE 2024

# langgraph dev watches the source tree and reloads on change. It also mounts
# the FastAPI app declared under "http" in langgraph.json, so the REST routes
# the admin frontend calls and the graph endpoints are both served on 2024.
CMD ["langgraph", "dev", "--host", "0.0.0.0", "--port", "2024", "--no-browser"]
