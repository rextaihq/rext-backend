{
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.*.local)",
      "Read(.env.development)",
      "Read(.env.production)",
      "Read(.env.test)",
      "Bash(git push * main)",
      "Bash(git push * staging)",
      "Bash(git push * stage)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(docker push *)",
      "Bash(gh workflow run *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-push.sh\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'The conversation was just compacted. If you are working a task of the app rework (an issue in revnix/rext-control), post a checkpoint on it now (done, remaining, next step, checked by, resume) and push your branch.'"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && n=$(git log --oneline '@{upstream}..HEAD' 2>/dev/null | wc -l) && [ \"$n\" -gt 0 ] && echo \"warning: $n unpushed commit(s) on $(git branch --show-current)\" || true"
          }
        ]
      }
    ]
  }
}
