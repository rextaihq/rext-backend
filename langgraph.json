{
  "dependencies": ["."],
  "graphs": {
    "agent": "main:graph"
  },
  "env": ".env",
  "image_distro": "wolfi",
  "http": {
    "app": "src/api/server.py:app"
  },
  "pip_installer": "uv",
  "dockerfile_lines": [
  "RUN apk add --no-cache --virtual .build-deps gcc musl-dev",
  "RUN apk add --no-cache nss freetype harfbuzz ca-certificates chromium-swiftshader",
  "RUN pip install --no-cache-dir --no-deps playwright crawl4ai",
  "RUN playwright install --with-deps chromium",
  "RUN crawl4ai-setup",
  "RUN apk del .build-deps"
]
}
