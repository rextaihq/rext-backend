{
  "dependencies": [
    "."
  ],
  "graphs": {
    "agent": "main:graph"
  },
  "env": ".env",
  "image_distro": "wolfi",
  "pip_installer": "uv",
  "http": {
    "app": "src/api/server.py:app"
  },
  "checkpointer": {
    "ttl": {
      "default_ttl": 259200,
      "sweep_interval_minutes": 30
    }
  },
  "store": {
    "path": "src/flow/store/rext_store.py:generate_store"
  },
  "dockerfile_lines": [
    "RUN pip install playwright crawl4ai",
    "RUN apk add --no-cache nss freetype harfbuzz ca-certificates chromium curl bash",
    "RUN playwright install",
    "RUN crawl4ai-setup",
    "RUN crawl4ai-doctor"
  ]
}