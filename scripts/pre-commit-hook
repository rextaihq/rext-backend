#!/bin/bash
#
# Git Pre-Commit Hook to Prevent Secret Leaks
#
# Installation:
#   cp scripts/pre-commit-hook .git/hooks/pre-commit
#   chmod +x .git/hooks/pre-commit
#
# This hook prevents:
# - .env files from being committed
# - LemonSqueezy API keys from being committed
# - Other secrets from being committed
#

set -e

# ANSI color codes
RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m' # No Color

echo -e "${GREEN}🔍 Running pre-commit security checks...${NC}"

# Check 1: Prevent .env file commits
if git diff --cached --name-only | grep -qE '\.env$'; then
    echo -e "${RED}❌ ERROR: Attempting to commit .env file${NC}"
    echo -e "${YELLOW}"
    echo "   Files being committed:"
    git diff --cached --name-only | grep '\.env$'
    echo -e "${NC}"
    echo "   .env files contain secrets and should NEVER be committed to version control"
    echo ""
    echo "   To fix:"
    echo "   1. Remove .env from staging: git reset HEAD .env"
    echo "   2. Add to .gitignore if not already there: echo '.env' >> .gitignore"
    echo "   3. Commit .gitignore: git add .gitignore && git commit -m 'Add .env to gitignore'"
    echo ""
    exit 1
fi

# Check 2: Prevent LemonSqueezy API key commits
if git diff --cached --diff-filter=ACM | grep -qE 'LEMONSQUEEZY_API_KEY\s*=\s*[a-zA-Z0-9_-]{20,}'; then
    echo -e "${RED}❌ ERROR: LemonSqueezy API key detected in commit${NC}"
    echo -e "${YELLOW}"
    echo "   Found potential API key in staged changes"
    echo -e "${NC}"
    echo "   API keys should be stored in environment variables, not committed to git"
    echo ""
    echo "   To fix:"
    echo "   1. Remove the API key from your code"
    echo "   2. Store it in .env file (which is gitignored)"
    echo "   3. Load it via environment variables or config files"
    echo ""
    echo "   If you already committed this key:"
    echo "   1. Rotate the key IMMEDIATELY at https://app.lemonsqueezy.com/settings/api"
    echo "   2. Remove it from git history using git-filter-repo or BFG Repo-Cleaner"
    echo ""
    exit 1
fi

# Check 3: Prevent webhook secret commits
if git diff --cached --diff-filter=ACM | grep -qE 'LEMONSQUEEZY_WEBHOOK_SECRET\s*=\s*[a-zA-Z0-9_-]{20,}'; then
    echo -e "${RED}❌ ERROR: LemonSqueezy webhook secret detected in commit${NC}"
    echo -e "${YELLOW}"
    echo "   Found webhook secret in staged changes"
    echo -e "${NC}"
    echo "   Webhook secrets should be stored in environment variables, not committed to git"
    echo ""
    exit 1
fi

# Check 4: Prevent any long strings that look like API keys
if git diff --cached --diff-filter=ACM | grep -qE '["\x27][a-zA-Z0-9_-]{50,}["\x27]'; then
    echo -e "${YELLOW}⚠️  WARNING: Long string detected (possible API key/secret)${NC}"
    echo ""
    echo "   Found a long alphanumeric string in your changes"
    echo "   If this is an API key or secret, DO NOT commit it"
    echo ""
    echo -e "${YELLOW}   Suspicious strings:${NC}"
    git diff --cached --diff-filter=ACM | grep -E '["\x27][a-zA-Z0-9_-]{50,}["\x27]' || true
    echo ""
    echo "   If this is a legitimate value (e.g., test data), you can proceed"
    echo "   If this is a secret, remove it and use environment variables instead"
    echo ""
    read -p "   Do you want to proceed with this commit? (y/N) " -n 1 -r
    echo
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        echo -e "${RED}❌ Commit aborted${NC}"
        exit 1
    fi
fi

# Check 5: Warn about sensitive files
SENSITIVE_PATTERNS=(
    "password"
    "secret"
    "private_key"
    "api_key"
    "token"
    "credentials"
)

for pattern in "${SENSITIVE_PATTERNS[@]}"; do
    if git diff --cached --diff-filter=ACM | grep -iqE "\b${pattern}\b\s*="; then
        echo -e "${YELLOW}⚠️  WARNING: Possible sensitive data detected${NC}"
        echo "   Pattern found: ${pattern}"
        echo ""
        echo "   Please review your changes to ensure no secrets are committed"
        echo ""
        break
    fi
done

echo -e "${GREEN}✅ Pre-commit security checks passed${NC}"
exit 0
