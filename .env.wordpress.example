# WordPress Publishing Configuration
# Copy this to your .env file and fill in your credentials

# # WordPress site URL (without trailing slash)
# WORDPRESS_SITE_URL=https://rextpostpublisher.local

# # WordPress username
# WORDPRESS_USERNAME=admin

# # WordPress Application Password (from Users → Profile → Application Passwords)
# # Remove spaces when adding to .env
# WORDPRESS_APP_PASSWORD=DBC4ziu35ojHAOwfAMjRsApb
