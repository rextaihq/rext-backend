{
  "TEAM": {
    "description": "DISABLED - we only want blog authors",
    "keywords": {},
    "negative": []
  },
  "BLOG": {
    "description": "Pages containing blog articles with author bylines",
    "keywords": {
      "blog": 3,
      "articles": 3,
      "posts": 3,
      "news": 2,
      "author": 2,
      "writers": 2,
      "contributors": 2,
      "resources": 1,
      "guides": 1,
      "tutorials": 1
    },
    "negative": [
      "privacy",
      "terms",
      "login",
      "cart",
      "checkout"
    ]
  },
  "AUTHOR_BYLINE_PATTERNS": [
    "by\\s+([A-Za-z\\s\\-\\.]+?)(?:\\s*\\||,|\\n|$)",
    "author[:\\s]+([A-Za-z\\s\\-\\.]+?)(?:\\s*\\||,|\\n|$)",
    "written\\s+by\\s+([A-Za-z\\s\\-\\.]+?)(?:\\s*\\||,|\\n|$)",
    "posted\\s+by\\s+([A-Za-z\\s\\-\\.]+?)(?:\\s*\\||,|\\n|$)",
    "contributor[:\\s]+([A-Za-z\\s\\-\\.]+?)(?:\\s*\\||,|\\n|$)"
  ],
  "SOCIAL_PATTERNS": {
    "linkedin": "linkedin\\.com/in/[\\w\\-]+",
    "twitter": "twitter\\.com/[\\w]+",
    "github": "github\\.com/[\\w\\-]+",
    "website": "https?://[^\\s]+"
  },
  "METADATA": {
    "MAX_BLOG_ARTICLES_TO_SAMPLE": 10,
    "MAX_PAGE_CHARS": 4000,
    "AUTHOR_EXCERPT_CHARS": 2000,
    "BLOG_AUTHOR_BIO_CHARS": 500,
    "MAX_EXTRA_PAGES": 999
  }
}